---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTAButton from './CTAButton.astro';
import TrustChips from './TrustChips.astro';
import LocationCard from './LocationCard.astro';
import VideoCarousel from './VideoCarousel.astro';
import { siteConfig } from '../lib/siteConfig';
import needlegirlieHero from '../assets/photos/needlegirlie-hero.jpg';
import amyTreatingClient from '../assets/photos/amy-treating-client-neon.jpg';
import skinbetterInHand from '../assets/photos/skinbetter-in-hand.jpg';
import amyLavenderSuit from '../assets/photos/amy-lavender-suit.jpg';
import igPost from '../assets/photos/amy-ig-post.jpg';
import vanTreatmentInterior from '../assets/photos/van-treatment-interior.jpg';

/**
 * THE HOME PAGE (C8 flipped 2026-08-04 — index.astro renders this
 * component; /styleguide/concept keeps rendering it as the preview
 * mirror). Rebuilt 2026-07-25 on client direction (DECISIONS same
 * date): bright clear hero (the cinema grade retired from this page),
 * the ombre canvas showing through transparent middle sections, and
 * three category DOORS instead of the duplicated 12-card /services
 * menu. The disqualified prep-tray frame (pink-gloves-detail) and the
 * unconfirmed-release mirror frame are OFF the page; the italic face
 * import is gone (font budget + CLS discipline for the gates).
 *
 * C8 PREREQUISITES — ALL CLOSED 2026-08-04 (DECISIONS same date): the
 * then-hero client's release confirmed on the record by the operator;
 * Amy's sign-off on the IG post caption (baked pixels — linters cannot
 * read them, so her sign-off is the control); {{MEDIA_SCOPE}} closed as
 * per-item operator approval, the practice all along.
 *
 * HERO PHOTO since 2026-08-14 (DECISIONS same date): Amy's
 * studio-counter portrait — Amy alone, so the old hero's client-release
 * dependency is gone. Same frame Amy picked for the construction
 * window (DECISIONS 2026-08-05); here it ships as an interim
 * AI-assisted 1400w asset (see the media-div note below).
 *
 * The three category doors: Injectables / Skin & Body / Wellness match
 * the /services menu groups exactly (serviceLines CATEGORIES); the door
 * lines enumerate each group's four treatment lines factually.
 *
 * SCALE + RHYTHM ROUND (2026-09-03, operator direction after the design
 * critique; DECISIONS same date). At >=900px: the hero photo bleeds
 * toward the copy (the copy stays on SOLID noir — the Phase C
 * text-over-photo rule is kept, not excepted), the statement grows to
 * the full display clamp over a one-sentence lead, the section openers
 * step up to display sizes over one-sentence decks (the §6 credentials
 * kept as a compact line), and a noir statement band ("Amy comes to
 * you." beside the van interior — /mobile's first door on the home
 * page) punctuates the ombre between the doors and the visit beat. The
 * carousel's desktop
 * composition lives in VideoCarousel. Phones (<900px) are unchanged by
 * design — reviews happen on Amy's phone first (REDESIGN gap 7).
 */

/* Door photos replaced 2026-08-17 (Amy's picks, photo-replacement
 * round; screening + the client release for the treatment frame
 * recorded in DECISIONS same date). The outgoing assets stay in the
 * repo — /services and two treatment pages still render them. */
const doors = [
  {
    title: 'Injectables',
    line: 'Wrinkle relaxers, dermal fillers, biostimulators, and regenerative treatments.',
    /* Amy treating a client under the studio neon; faces sit
     * center-upper — the smart crop finds them */
    photo: amyTreatingClient,
    position: 'attention',
  },
  {
    title: 'Skin & Body',
    line: 'Skin rejuvenation, body contouring, laser treatments, and medical-grade skincare.',
    /* the three skinbetter products held to camera, mid-frame */
    photo: skinbetterInHand,
    position: 'attention',
  },
  {
    title: 'Wellness',
    line: 'Weight management, peptide therapy, IV therapy, and hormone optimization.',
    /* Amy in the lavender suit; near-4:5 source, minimal crop */
    photo: amyLavenderSuit,
    position: 'attention',
  },
] as const;

/* The MA chevrons for the scroll cue (hand-copied from VisitSteps.astro,
 * itself from the brand mark; MA is Amy's own PLLC). Rotated 90° in CSS
 * to point down; decorative. HOME CONCEPT 2026-09-03. */
const CHEVRONS = [
  'M24.19 108.00 L42.19 108.00 L89.49 158.98 L42.16 210.00 L24.16 210.00 L71.49 158.98 Z',
  'M84.99 108.00 L102.99 108.00 L150.28 158.98 L102.95 210.00 L84.95 210.00 L132.28 158.98 Z',
  'M146.07 108.00 L164.07 108.00 L211.36 158.98 L164.04 210.00 L146.04 210.00 L193.36 158.98 Z',
  'M207.02 108.00 L225.02 108.00 L272.32 158.98 L224.99 210.00 L206.99 210.00 L254.32 158.98 Z',
];
---

{/* Light body (default): the ombre canvas paints the page; the hero and
    closing band re-scope themselves noir per-section. Middle sections are
    TRANSPARENT — the ramp is the surface (client direction 2026-07-25:
    "employ the ombre background — this page looks like it doesn't belong
    to the site"). */}
<BaseLayout
  title="Needle Girlie | Medical Aesthetics in Harrisburg, NC"
  description="Needle Girlie — the medical-aesthetics practice of Amy Palacios, FNP, in Harrisburg, NC. Injectables, skin, body, and wellness, every appointment with Amy."
>
  <Header slot="header" />

  {/* ---- HOME CONCEPT (2026-09-03): the motion layer. The operator lifted
      the zero-JS rule FOR THIS BRANCH (concept test; DECISIONS same
      date). Static same-origin files only — script-src stays 'self'.
      motion-flag runs synchronously so the choreographed elements can
      start hidden without a flash; the engines and the choreography are
      deferred in order. Under reduced motion, or if any file fails, the
      page is the CSS-only home from this branch (motion-flag
      self-cancels). Script bytes: ~155KB raw / ~65KB gzipped — over the
      house 30KB script budget BY THE OPERATOR'S DECISION for this
      branch: lighthouserc.json carries a HOME-ONLY row at 80KB for the
      branch (the PR preview workflow runs the gates before deploying,
      so the lift had to reach the gate or there is no preview); every
      other budget and every other page keep the house row. ---- */}
  <Fragment slot="head">
    <script is:inline src="/js/motion-flag.js"></script>
    <script is:inline defer src="/js/vendor/gsap.min.js"></script>
    <script is:inline defer src="/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline defer src="/js/vendor/SplitText.min.js"></script>
    <script is:inline defer src="/js/vendor/lenis.min.js"></script>
    <script is:inline defer src="/js/home-motion.js"></script>
  </Fragment>

  {/* ---- HERO: noir band, Amy herself — seated on the studio counter
      beneath her own neon script (her own signage — sole owner,
      DECISIONS 2026-07-23), the frame Amy picked for the front door
      (2026-08-14; the same photo she chose for the construction
      window, DECISIONS 2026-08-05). BRIGHT and clear: the cinema grade
      stays retired (client 2026-07-25); the photo wears the light wash
      + a thin magenta unifier, with a soft neon bloom where the sign's
      real glow falls — right of Amy in this frame. EXEMPT from the
      sitewide arch motif (operator, 2026-08-17): the hero is the
      full-bleed backdrop, not a framed picture. ---- */}
  <section class="nc-hero surface" data-surface="noir">
    {/* HOME CONCEPT (2026-09-03): the media is a film facade — Amy's
        portrait <Image> is what ships and paints (LCP unchanged);
        home-motion.js attaches her studio reel (the carousel's muted
        rendition at the recorded 0.5×, captions track from public/media)
        a beat after `load`, fading it in over the portrait. data-ranges
        TRIMS the reel to its three treatment passages (seconds of the
        master, played in order and looped, dissolves at the joins): the
        hero's cover crop would otherwise show the reel's car selfie, the
        packaging-in-hand shots, and the table with promo flyers at a
        size the carousel's bounded stage never did — a trim is an
        editorial choice, recorded (DECISIONS 2026-09-03 addendum), not an
        override. The burned-in "POV" caption is Amy's own published
        wording and stays in frame. data-hold (operator's first tweak,
        same day — "it changes pictures too fast"): each passage rests
        on its last frame for 3.5s before dissolving into the next, so
        the film reads as three held scenes rather than quick cuts.
        data-plays (second tweak, same day — "run two times, then rest
        on the original hero pic"): after the second pass the film
        dissolves out over the portrait it faded in from, the portrait
        settles, and the film element is removed — it ends where it
        began and never replays until the page reloads. Reduced motion:
        the film still plays (operator decision 2026-09-03 — films are
        content, the carousel policy); only the choreography stands
        down. Phones: a refused play() retries on the first gesture. */}
    <div
      class="nc-hero__media"
      aria-hidden="true"
      data-hero-film
      data-file={`${siteConfig.mediaBase}/commercial-studio.mp4`}
      data-vtt="/media/commercial-studio.vtt"
      data-label="A day inside Amy's Harrisburg studio"
      data-rate="0.5"
      data-ranges="10.4-11.72,2.5-3.25,6.15-6.78"
      data-hold="3.5"
      data-plays="2"
    >
      {/* INTERIM AI-ASSISTED ASSET (disclosed — DECISIONS 2026-08-14):
        * the only available source is a 642px social-size save, well
        * below this slot's 1400px delivery, so the committed JPEG is a
        * 55/45 Real-ESRGAN/lanczos blend at 1400w (raw ESRGAN output
        * was rejected: waxy face rendering). Amy approves the enhanced
        * rendering of her own likeness on the preview. When her
        * full-resolution original surfaces, re-encode it over
        * needlegirlie-hero.jpg — zero code changes needed here. */}
      <Image
        src={needlegirlieHero}
        alt=""
        widths={[760, 1080, 1400]}
        sizes="(max-width: 900px) 100vw, 58vw"
        class="nc-photo nc-hero__img ng-settle"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="nc-hero__copy">
      <p class="eyebrow">Harrisburg, NC · By appointment</p>
      <h1 class="nc-display mt-5">
        Medical Aesthetics,
        <span class="display-accent ng-shimmer">made personal.</span>
      </h1>
      {/* One sentence, the one thing only this practice can say (2026-09-03;
          the former two-line lead is on the record in DECISIONS). */}
      <p class="lead nc-hero__lead mt-6">
        One clinician, every appointment. Amy Palacios, FNP, in medical
        aesthetics since 2017.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <CTAButton variant="book" />
        <CTAButton variant="call" />
      </div>
      <div class="mt-8">
        <TrustChips />
      </div>
      {/* The scroll cue: the four MA chevrons, pointing down, pulsing in
          sequence (CSS). HOME CONCEPT 2026-09-03. */}
      <div class="nc-cue" aria-hidden="true">
        <svg viewBox="24.16 108 248.16 102" fill="none">
          {CHEVRONS.map((d) => <path d={d} />)}
        </svg>
      </div>
    </div>
  </section>

  {/* ---- COMMERCIALS: the cinematic noir stage, directly after the hero
      (operator direction 2026-08-14 — the Audi treatment; slides
      crossfade, zero player chrome; see VideoCarousel for the
      compliance + behavior contract). ---- */}
  <VideoCarousel />

  {/* ---- INTRO / MEET AMY: first ombre beat — transparent on the canvas.
      Carries the §6 "Meet Amy" trust block as a factual credentials
      paragraph. Opener keeps the traced rule; the label is dropped
      (taste-audit eyebrow ration — the heading carries the section). ---- */}
  <section>
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[5fr_4fr] md:items-center md:gap-16 md:py-28">
      <div>
        <hr class="rule-accent ng-trace" aria-hidden="true" />
        <h2 class="heading-2 md:display-0 mt-6">Your plan, your pace.</h2>
      </div>
      <div class="ng-rise">
        {/* One-sentence deck (2026-09-03); the §6 "Meet Amy" credentials
            stay below it as a compact line — never dropped. */}
        <p class="lead nc-lead-lg">
          Book when you are ready, or talk it through with Amy first. Every
          decision is made with her, at your pace.
        </p>
        <p class="nc-credentials mt-6">
          Licensed family nurse practitioner, two decades in nursing, in medical
          aesthetics since 2017, and a Biote-certified provider.
          <a href="/about" class="nc-more">More about Amy
            <span class="chev-nudge" aria-hidden="true">&rsaquo;</span></a>
        </p>
        <p class="eyebrow mt-6">Amy Palacios, FNP</p>
      </div>
    </div>
  </section>

  {/* ---- CATEGORY DOORS: the services teaser (client-picked over the
      duplicated menu). Three arch-framed photo plates — the house arch
      geometry as the door frame — matching the /services menu groups;
      whole card links to /services (link-overlay pattern, axe-safe).
      Door photos are decorative to the labeled links (alt=""). ---- */}
  <section>
    <div class="mx-auto max-w-6xl px-6 py-20">
      <hr class="rule-accent ng-trace" aria-hidden="true" />
      <h2 class="heading-2 md:display-1 mt-6">What Amy offers</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          /* ng-rise-2/-3: the second and third doors rise later (stagger,
           * global.css, 2026-09-03). */
          doors.map((door, i) => (
            <article
              class:list={[
                'nc-door ng-lift ng-rise',
                i === 1 && 'ng-rise-2',
                i === 2 && 'ng-rise-3',
              ]}
            >
              <figure class="nc-door__arch ng-arch" aria-hidden="true">
                <Image
                  src={door.photo}
                  alt=""
                  width={640}
                  height={800}
                  fit="cover"
                  position={door.position}
                  quality={62}
                  widths={[400, 640]}
                  sizes="(max-width: 640px) 88vw, 30vw"
                  loading="lazy"
                />
              </figure>
              <h3 class="nc-door__title">
                <a href="/services" class="nc-door__link">{door.title}</a>
              </h3>
              <p class="nc-door__line mt-2">{door.line}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-center">
        <a href="/services" class="nc-more nc-more--lg">Explore all twelve lines
          <span class="chev-nudge" aria-hidden="true">&rsaquo;</span></a>
      </p>
    </div>
  </section>

  {/* ---- THE STATEMENT BAND: the ombre's noir punctuation (2026-09-03).
      The van interior — Amy's treatment room on wheels, the /mobile
      hero's screened 4:5 crop (2026-09-02; the frame's prep-workflow
      third is outside the window), no people, no packaging — bleeds
      from the left edge; the statement sits on noir to its right, never
      over the photo (Phase C plate rule), and gives /mobile its first
      door on the home page. As a full-bleed backdrop the photo is
      EXEMPT from the arch motif under the hero-backdrop rationale — the
      fifth exemption (DECISIONS 2026-09-03). Retina: the photo column
      is min(60%, 48rem) — 768px CSS at 1280 and capped there above it —
      against the 1536px source: 2× exactly. (The first pick for this
      slot, Amy holding her neon sign, was rejected on the record: at
      band size the Evolysse carton on the table reads, and Amy retired
      Evolysse content from the site 2026-08-21.) ---- */}
  <section class="nc-band surface" data-surface="noir" aria-labelledby="nc-band-heading">
    <figure class="nc-band__media" aria-hidden="true">
      <Image
        src={vanTreatmentInterior}
        alt=""
        widths={[760, 1080, 1536]}
        sizes="(min-width: 900px) min(60vw, 48rem), 100vw"
        quality={62}
        loading="lazy"
        class="nc-photo ng-drift"
      />
    </figure>
    <div class="nc-band__copy">
      <h2 class="heading-2 md:display-1" id="nc-band-heading">Amy comes to you.</h2>
      <p class="lead nc-lead-lg mt-6">
        Homes, offices, and gatherings around Charlotte, in a van fitted out as a
        treatment room.
      </p>
      <p class="mt-8">
        <a href="/mobile" class="nc-more nc-more--lg">How a party works
          <span class="chev-nudge" aria-hidden="true">&rsaquo;</span></a>
      </p>
    </div>
  </section>

  {/* ---- THE VISIT + LOCATION: canvas beat, photo-free. The reassurance
      copy routes to /visit; LocationCard carries the §6 location strip
      (NAP + directions link-out). ---- */}
  <section>
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[5fr_4fr] md:gap-16">
      <div>
        <hr class="rule-accent ng-trace" aria-hidden="true" />
        <h2 class="heading-2 md:display-2 mt-6">Unhurried, explained, and yours to decide.</h2>
        <p class="mt-4 max-w-prose">
          Time to talk before anything begins: nothing is rushed, and nothing is
          decided without you. See how a visit works, from booking to aftercare.
        </p>
        <p class="mt-4">
          <a href="/visit" class="nc-more">Plan your visit
            <span class="chev-nudge" aria-hidden="true">&rsaquo;</span></a>
        </p>
      </div>
      <div class="ng-rise self-center">
        <LocationCard />
      </div>
    </div>
  </section>

  {/* ---- AMY'S VOICE: her own post, framed like a print, on the deep
      canvas. Presented as what it is (an Instagram post, operator-
      supplied clean version) — no grade. Size is the recorded client
      pick (34rem — the baked caption must read comfortably). NOTE for
      operator review, unchanged: the baked-in caption text is invisible
      to lint:claims / lint:voice (they cannot read pixels); it is Amy's
      own published wording, riding her ownership of the post. Her
      on-record caption sign-off is a C8 prerequisite; the slot is
      post-agnostic if she prefers a different post. ---- */}
  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-[6fr_5fr] md:gap-16">
      <div class="nc-post ng-rise">
        <Image
          src={igPost}
          alt="A post from Amy's Instagram: Amy in a lavender blazer, hair in motion, with her note on practicing the craft behind the needle, signed Needle Girlie"
          widths={[480, 720]}
          sizes="(max-width: 900px) 92vw, 48vw"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">From Amy's Instagram</p>
        <hr class="rule-accent ng-trace mt-2" aria-hidden="true" />
        <h2 class="heading-3 mt-6">In her own words.</h2>
        <p class="mt-4 max-w-prose">
          The craft, the practice, and the person behind the needle: Amy shares it as
          she goes.
        </p>
        <div class="mt-8">
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener" class="cta cta--chip">
            Follow Amy on Instagram
            <span class="chev-nudge" aria-hidden="true">&rsaquo;</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---- CLOSING: the sitewide noir bookend — same anatomy as the
      /services, /about, /visit, and treatment closing bands (photo-free;
      the studio frame moved to the Wellness door). ---- */}
  <section class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <h2 class="display-2">
        Ready <span class="display-accent ng-shimmer">when you are</span>.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <CTAButton variant="book" />
        <CTAButton variant="call" />
      </div>
      <div class="mt-8">
        <TrustChips />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  /* ---- Concept-scoped styles (nc-*) — none of this touches the design
   * system until the direction is approved. Rebuilt 2026-07-25: cinema
   * grade retired, blush/paper section paint removed (the ombre canvas
   * is the surface), band/arch/italic styles deleted with their
   * consumers. ---- */

  /* The light wash (site photo language) + a thin magenta unifier via
   * the overlay below — the 30%-gray cinema grade is retired from this
   * page (client 2026-07-25). */
  .nc-photo {
    filter: grayscale(10%) contrast(1.03) brightness(1.08);
  }
  .nc-hero__media {
    position: relative;
    overflow: hidden;
  }
  /* Thin brand unifier — replaces the retired 160deg noir multiply.
   * Same strength family as the /services strip wash (10-12%). */
  .nc-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--ng-magenta-600) 12%, transparent);
    mix-blend-mode: multiply;
  }
  /* Neon boost, softened: the sign's real glow, not a filter effect. */
  .nc-hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      36% 24% at 86% 30%,
      color-mix(in srgb, var(--ng-neon-500) 24%, transparent),
      transparent 70%
    );
    mix-blend-mode: screen;
  }

  /* HERO — split editorial: type left, photo right; stacked on mobile. */
  .nc-hero {
    display: grid;
  }
  .nc-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Anchor high in the frame: the hero windows (88vh desktop ≈ 1:1,
     * 58vh mobile ≈ 0.8) are both WIDER than the 0.72 source, so cover
     * trims vertically. Amy's face and the neon script both sit in the
     * source's upper third — 20% holds both in frame at both
     * breakpoints (the trim comes out of the counter below); verify on
     * screenshots before changing. */
    object-position: 50% 20%;
  }
  .nc-hero__copy {
    padding: 3rem 1.5rem 4rem;
  }
  @media (max-width: 899px) {
    .nc-hero__media {
      height: 58vh;
      /* photo melts into the noir text block below */
      mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
    }
  }
  /* >=900px (2026-09-03): the photo bleeds toward the copy. It is
   * absolutely placed from 44% of the width to the right edge and masked
   * in over its first 30% (full opacity from ~61% of the viewport). The
   * copy column is capped at 43vw (40rem at most) with a 4vw left pad,
   * so its widest line — "Aesthetics," at 7.2vw, or the balanced "made
   * personal." at tablet widths — ends before 44% at every width from
   * 900px up: every glyph sits on solid noir and the Phase C plate rule
   * holds without an exception (measured at 900/1024/1280/1440/1920:
   * glyph and paragraph right edges vs the media's left edge,
   * 2026-09-03). A bottom scrim rides the media's own overlay (dark
   * gloss, gap 4). The media box at 1280 is 708×~900 — the source's own
   * 0.72 aspect, so the frame shows whole. */
  @media (min-width: 900px) {
    .nc-hero {
      display: block;
      position: relative;
      min-height: 92vh;
      overflow: hidden;
    }
    .nc-hero__copy {
      position: relative;
      z-index: 3;
      max-width: min(40rem, 43vw);
      padding: clamp(4rem, 9vh, 7rem) 1.5rem 4rem clamp(2rem, 4vw, 4rem);
    }
    .nc-hero__media {
      position: absolute;
      inset: 0 0 0 44%;
      mask-image: linear-gradient(to right, transparent 0%, black 30%);
    }
    .nc-hero__media::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, transparent 30%),
        color-mix(in srgb, var(--ng-magenta-600) 12%, transparent);
    }
  }

  /* Magazine headline — bigger than display-0; upright only (the italic
   * face import is retired: font budget + swap-CLS discipline for the
   * future / gates). Cap raised 2026-09-03 (gap 2: enormous type) — the
   * vw term stays 7.2 so the headline clears the bleeding photo at every
   * width (see the >=900px hero note above). */
  .nc-display {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.75rem, 7.2vw, 7.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* Inline editorial links on the canvas: ink + underline (the ombre
   * re-inks make --ng-link ink-900 here); chevron nudges on hover. */
  .nc-more {
    color: var(--ng-link);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .nc-more--lg {
    font-size: 1.125rem;
  }

  /* CATEGORY DOORS — plate anatomy (SITE-WIDE BOXES tokens) framing an
