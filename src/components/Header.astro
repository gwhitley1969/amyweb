---
import { Image } from 'astro:assets';
import { siteConfig } from '../lib/siteConfig';
import wordmark from '../assets/brand/needle-girlie-wordmark-alpha.png';
import maMark from '../assets/brand/mobile-aesthetics-mark.svg';

/**
 * Noir sitewide header (approved design plan). Mobile nav uses the native
 * Popover API — zero JS: the browser handles toggling, Esc-close, and
 * light-dismiss. Browsers without support (pre-Safari 17) ignore the
 * attribute, so the nav simply renders expanded — graceful degradation.
 * The header/page edge is a hard cut: chrome, not a content boundary —
 * it never takes a chevron seam.
 */
/* "Book" goes straight to Vagaro (conversion pattern; client 2026-07-18).
 * The /book routing page was retired 2026-07-21 (operator) — every
 * booking path is Vagaro-direct. */
const nav: { label: string; href: string; external?: boolean }[] = [
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Visit', href: '/visit' },
  /* Professional-audience page (operator placement decision 2026-08-04):
   * the one non-client item, kept ahead of the conversion link so Book
   * stays the row's terminal action. */
  { label: 'Training', href: '/injector-training' },
  { label: 'Book', href: siteConfig.booking.vagaroUrl, external: true },
];

/* Current-page marker (taste audit 2026-07-25): exact match -> "page";
 * a /services subpage marks Services as the current section ("true").
 * Build-time only — Astro.url.pathname is the page being rendered; the
 * external Book link is never current. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentFor = (item: (typeof nav)[number]): 'page' | 'true' | undefined => {
  if (item.external) return undefined;
  if (path === item.href) return 'page';
  if (item.href === '/services' && path.startsWith('/services/')) return 'true';
  return undefined;
};
---

<div class="surface site-header" data-surface="noir">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 sm:py-6">
    <div class="site-brand-group">
      {/* Mobile Aesthetics mark, far left (operator direction 2026-08-15;
          redesign requirement #6). Vector rebuild from the practice's own
          F-437304 300px render — MA is Amy's sole-owner PLLC (DECISIONS
          2026-07-23), so naming it engages no other provider. Plain image,
          not a link: the home link stays the wordmark's alone. FULL BADGE
          variant (operator pick 2026-08-15, superseding the lockup
          recommendation): the complete tile — plate, frame, name and
          phone — so the mark never reads truncated. */}
      <img
        src={maMark.src}
        alt="Mobile Aesthetics PLLC"
        width="300"
        height="300"
        class="site-brand-mark shrink-0"
      />
      <a href="/" class="site-brand shrink-0">
        {/* Big by design — operator/client direction: the brand leads.
            Scaled up twice per client review 2026-07-18. Chevron motif
            retired from the UI same day (client) — it lives on only inside
            the logo artwork itself. Mobile width is a clamp so the row
            (mark + wordmark + menu toggle) fits 360px screens. */}
        <Image
          src={wordmark}
          alt="Needle Girlie — home"
          width={440}
          densities={[1, 2, 3]}
          class="h-auto w-[clamp(170px,52vw,215px)] sm:w-[440px]"
        />
        {/* Credential line under the wordmark (operator 2026-07-19).
            pink-500 small text is legal on noir ONLY — see the (min 4.5)
            pair in tokens.css. */}
        <span class="site-brand-credit">Amy Palacios, FNP</span>
      </a>
    </div>
    <nav aria-label="Primary">
      {/* desktop */}
      <ul class="hidden items-center gap-8 sm:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-nav-link"
                aria-current={currentFor(item)}
                {...(item.external
                  ? { target: '_blank', rel: 'noopener', 'data-event': 'book_click' }
                  : {})}
              >
                {item.label}
                {item.external && <span class="sr-only">(opens in new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
      {/* mobile: popover toggle */}
      <button popovertarget="mobile-nav" class="site-nav-toggle" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <span class="sr-only">Menu</span>
      </button>
      <ul id="mobile-nav" popover="auto" class="surface site-nav-popover" data-surface="noir">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-nav-link block px-6 py-3"
                aria-current={currentFor(item)}
                {...(item.external
                  ? { target: '_blank', rel: 'noopener', 'data-event': 'book_click' }
                  : {})}
              >
                {item.label}
                {item.external && <span class="sr-only">(opens in new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style is:global>
  .site-header {
    border-bottom: 1px solid var(--ng-hairline);
  }
  /* Left group: the Mobile Aesthetics mark sits beside the brand link.
   * The mark's height (not width) is the control — its 247:172 box keeps
   * the aspect. */
  .site-brand-group {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .site-brand-mark {
    width: auto;
    height: 56px; /* square badge — narrower than the lockup was, so the
                     row gains slack even a size up */
  }
  @media (min-width: 640px) {
    .site-brand-group {
      gap: 1.25rem;
    }
    .site-brand-mark {
      height: 112px;
    }
  }
  /* Brand lockup: wordmark with the credential line beneath. Same
   * uppercase tracked grammar as the nav; brand pink-500 to echo the
   * logo lettering (5.95:1 on noir — verified small-text pair). */
  .site-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }
  .site-brand-credit {
    color: var(--ng-pink-500);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  @media (min-width: 640px) {
    .site-brand-credit {
      font-size: 0.9375rem;
    }
  }
  /* Editorial nav: uppercase tracked labels (eyebrow grammar at nav size).
   * Sized up per client review 2026-07-18. */
  .site-nav-link {
    color: var(--ng-text);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .site-nav-link:hover {
    color: var(--ng-link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* The current page keeps a persistent underline in the brand pink —
   * quiet orientation; aria-current carries it for assistive tech
   * (taste audit 2026-07-25). Text color is untouched (contrast pairs
   * unchanged); the decoration is supplementary, aria-current is the
   * accessible signal. */
  .site-nav-link[aria-current] {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--ng-pink-500);
  }
  .site-nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    color: var(--ng-text);
    background: none;
    border: none;
    cursor: pointer;
  }
  /* desktop: the inline list is visible, so the toggle goes away — kept in
   * component CSS because the base display rule above would out-cascade a
   * Tailwind sm:hidden utility */
  @media (min-width: 640px) {
    .site-nav-toggle {
      display: none;
    }
  }
  .site-nav-popover {
    /* popover-open state */
    position: fixed;
    inset: auto 1rem auto auto;
    top: 6.75rem; /* clears the brand block — re-tuned for the clamped
                     mobile wordmark (2026-08-15, MA-mark row) */
    min-width: 12rem;
    margin: 0;
    padding: 0.5rem 0;
    border: 1px solid var(--ng-hairline);
    border-radius: 0.25rem;
    list-style: none;
  }
  /* Browsers without Popover support ignore the attribute; the list then
   * flows inline — give it sane inline styling instead of the overlay's. */
  @supports not selector(:popover-open) {
    .site-nav-popover {
      position: static;
      border: none;
      display: flex;
      gap: 0.5rem;
    }
  }
</style>
