---
import { Image } from 'astro:assets';
/* The 2026-09-15 logo (docs/BRAND-ASSETS.md) — the same crop the header
 * uses; the old chevron lockup is dormant in src/assets/brand/. The cap is
 * 960px: the master is 1983px wide, so 2x retina holds up to 960 and not
 * the 1040 the old 1879px lockup allowed. */
import lockup from '../assets/brand/needle-girlie-wordmark-metallic-alpha.png';

/**
 * The sign, composed ("serious glamour", DECISIONS 2026-07-18): noir
 * surface, lockup under a STATIC aura — the neon identity held still —
 * the page h1 as visible text (the promise), CTAs via slot. The lockup
 * image is decorative-adjacent brand art; the h1 carries the content.
 */
interface Props {
  /** The one-line promise — claim-clean, operator-approved wording. */
  promise: string;
  /** Optional editorial kicker above the promise (claim-clean). */
  eyebrow?: string;
}

const { promise, eyebrow } = Astro.props;
---

<section class="surface" data-surface="noir">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-6 py-16 text-center">
    {/* Near-full-bleed by design — client direction: "it's got to be big." */}
    <Image
      src={lockup}
      alt="Needle Girlie"
      width={960}
      widths={[480, 800, 1200, 1920]}
      sizes="(max-width: 1020px) 94vw, 960px"
      class="ng-aura ng-aura-live w-full max-w-[960px]"
      loading="eager"
      fetchpriority="high"
    />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display-2 text-balance">{promise}</h1>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <slot />
    </div>
  </div>
</section>
