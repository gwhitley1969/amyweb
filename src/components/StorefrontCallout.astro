---
import CTAButton from './CTAButton.astro';
import qrSvg from '../assets/brand/skinbetter-registration-qr.svg';

/**
 * Branded Skinbetter storefront handoff plate — /services/skincare only
 * (competitor-comparison decision, DECISIONS 2026-07-23). Text-only
 * branding until partner brand assets arrive; the statement phrasing
 * ("custom … storefront") comes from Skinbetter's own counter card.
 * Noir per-section is the sanctioned dark treatment — tokens re-scope
 * under data-surface, so contrast rides the vetted noir pairs.
 *
 * The QR tile (2026-08-25, operator direction — DECISIONS same date):
 * encodes the operator-supplied skinbetter.com registration URL with
 * the practice's businessPartner_id, round-trip decode-verified against
 * the committed SVG. The QR is never the only route — the shop button
 * beside it is the click path — and the tile stays white with black
 * modules for scanner contrast (an inverted QR on noir scans poorly).
 * The caption color is the raw ink token, not --ng-text, because the
 * tile is a fixed white box inside a noir scope.
 */
---

<aside
  class="storefront-callout surface"
  data-surface="noir"
  aria-label="Skinbetter Science storefront"
>
  <div class="callout-row">
    <div>
      <p class="eyebrow">Skinbetter Science &middot; Authorized provider</p>
      <p class="callout-statement">
        Amy&rsquo;s custom Skinbetter storefront &mdash; the complete line,
        shipped to your door.
      </p>
      <div class="mt-6">
        <CTAButton variant="shop" />
      </div>
    </div>
    <figure class="qr-tile">
      <img
        src={qrSvg.src}
        alt="QR code for Amy's Skinbetter Science storefront registration."
        width="168"
        height="168"
        loading="lazy"
      />
      <figcaption>Scan to register and shop from your phone.</figcaption>
    </figure>
  </div>
</aside>

<style>
  .storefront-callout {
    margin-top: 2.5rem;
    padding: 2rem 1.75rem;
    /* squared editorial corners, matching .cta and the card plates */
    border-radius: 2px;
  }
  .callout-statement {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5625rem; /* heading-4 scale, display voice */
    line-height: 1.3;
    max-width: 26ch;
  }
  .callout-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .qr-tile {
    margin: 0;
    background: #ffffff; /* matches the SVG's baked quiet zone — one seamless tile */
    border-radius: 12px; /* the house 12px foot corner */
    padding: 0.75rem 0.75rem 0.625rem;
    width: 10.5rem;
    text-align: center;
  }
  .qr-tile img {
    display: block;
    width: 100%;
    height: auto;
  }
  .qr-tile figcaption {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ng-ink-900);
  }
</style>
