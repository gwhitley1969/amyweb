---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../lib/siteConfig';

/**
 * Self-hosted treatment film (first used on /services/dermal-fillers —
 * operator decisions recorded in docs/DECISIONS.md, 2026-07-21).
 * Click-to-play only: `preload="none"` keeps the file out of the page
 * budget entirely until the visitor asks for it, the poster carries the
 * visual, and native controls mean zero client-side JavaScript. No
 * autoplay, so no reduced-motion or pause obligations arise. The captions
 * track is required — the a11y gate (axe video-caption) fails without it.
 *
 * MEDIA ORIGIN (2026-08-17, DECISIONS same date): the .mp4 serves from
 * siteConfig.mediaBase (Blob behind the same Front Door). The `src`
 * prop KEEPS its historical "/media/<file>.mp4" form and is rewritten
 * here, because the prop lives in treatment MDX frontmatter and any
 * MDX edit resets clinicianApproved (constraint 4) — the same
 * component-layer mirror the arch motif uses. Captions stay
 * same-origin in public/media/ (in-repo compliance audit trail;
 * same-origin tracks need no CORS, so no crossorigin attribute), with
 * their cache route still in config/swa/.
 *
 * SIZING (first portrait films 2026-08-21, /services/biostimulators):
 * the player is aspect-agnostic — the poster's intrinsic width/height
 * set the box and `width:100%; height:auto` follow it — so a 9:16 film
 * is sized by its CONTAINER. Standalone (/about) that is the column;
 * inside a treatment media-row the layout's `.media-row .video-figure`
 * rule supplies the 2fr column + the 18rem cap (TreatmentLayout). The
 * poster derivative is requested at min(1280, source width): Astro's
 * sharp service upscales on request, and a poster above its source
 * is the retina rule's "never upscale" corollary broken in reverse.
 *
 * FRAME: `frame="mat"` (default) is the recorded standalone look —
 * the paper mat kept for film players when the treatment photos went
 * bare (DECISIONS 2026-08-18). `frame="bare"` is for a film INSIDE a
 * media row beside bare arches (DECISIONS 2026-08-21): no mat, the
 * arch family's hairline + 12px foot corners on the video, never the
 * arch itself. Manufacturer film stages stay unmasked (their burned-in
 * safety information ships complete); site-authored films may wear
 * the corners.
 *
 * FILM CLASSES: manufacturer creative is carried as-is (Evolysse,
 * ICON); Amy's own published reels are site-authored — each ships
 * under its own per-film DECISIONS entry (screening record, operator
 * decisions, releases), and their labels/captions describe only what
 * the pixels self-identify.
 */
interface Props {
  /** Public path to the MP4, e.g. "/media/evolysse-film.mp4" — rewritten
   * onto siteConfig.mediaBase at render (never edit the MDX side). */
  src: string;
  /** Poster frame — processed through astro:assets. */
  poster: ImageMetadata;
  /** Public path to the WebVTT captions file. */
  captionsSrc: string;
  /** Accessible name for the video element. */
  label: string;
  /** Optional printed caption under the frame. */
  caption?: string;
  /** Frame treatment: 'mat' (default — the standalone paper mat) or
   * 'bare' (inside a treatment media-row beside bare arches). */
  frame?: 'mat' | 'bare';
}

const { src: srcProp, poster, captionsSrc, label, caption, frame = 'mat' } = Astro.props;

// "/media/evolysse-film.mp4" -> "https://media.needlegirlie.com/evolysse-film.mp4"
const src = srcProp.startsWith('/media/')
  ? `${siteConfig.mediaBase}/${srcProp.slice('/media/'.length)}`
  : srcProp;

// Never above the source width — see SIZING in the header.
const posterWidth = Math.min(1280, poster.width);
const posterImg = await getImage({ src: poster, width: posterWidth, format: 'webp' });
---

<figure class:list={['video-figure', frame === 'bare' && 'video-figure--bare']}>
  <video
    controls
    preload="none"
    playsinline
    width={poster.width}
    height={poster.height}
    poster={posterImg.src}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    <track kind="captions" src={captionsSrc} srclang="en" label="English" default />
    Your browser doesn't support embedded video — <a href={src}>download the film</a> instead.
  </video>
  {caption && <figcaption class="eyebrow">{caption}</figcaption>}
</figure>

<style>
  /* Framed like the media-row prints (paper mat + hairline + lift), but
   * straight — a tilted frame reads wrong on an interactive element. */
  .video-figure {
    margin-top: 2.5rem;
    background: var(--ng-paper);
    border: 1px solid var(--ng-hairline);
    padding: 0.625rem;
    box-shadow: 0 14px 28px -16px color-mix(in srgb, var(--ng-ink-900) 40%, transparent);
  }
  .video-figure video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--ng-ink-900);
  }
  .video-figure figcaption {
    margin-top: 0.5rem;
    text-align: center;
  }
  /* Bare variant (2026-08-21): written with both classes so it beats
   * the base rule by specificity, not source order (scoped classes
   * otherwise tie). The hairline and 12px corners are the arch's foot
   * vocabulary — the same magenta hairline the bare arches wear. */
  .video-figure.video-figure--bare {
    background: none;
    border: 0;
    padding: 0;
    box-shadow: none;
  }
  .video-figure.video-figure--bare video {
    border-radius: 12px;
    border: 1px solid var(--ng-magenta-600);
  }
</style>
