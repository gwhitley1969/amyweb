---
import '@fontsource-variable/playfair-display';
import playfairWoff2 from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { localBusiness } from '../lib/schema';
import { siteConfig } from '../lib/siteConfig';

// Cookieless analytics, prepped 2026-08-17 and gated DARK behind
// siteConfig.analytics (constraint 5: cookieless only; Plausible sets
// no cookies and keeps no personal identifiers). While disabled this
// renders nothing — the flip is a siteConfig edit, the operator's act.
// The tracker is SELF-HOSTED (public/js/plausible.js — the site rule:
// scripts are static files; script-src stays 'self'); only the event
// POST leaves the origin, and generate-swa-config.mjs sniffs the
// BUILT page for the script tag and admits plausible.io in
// connect-src only when it actually shipped.
const analyticsOn = siteConfig.analytics.enabled && siteConfig.analytics.provider === 'plausible';

interface Props {
  title: string;
  description: string;
  /** Page surface: light "studio" (default — wears the site-wide ombre
   * canvas since 2026-07-23, client-approved) or dark "sign"
   * (BUILD_SPEC §5). The ombre is styled off this surface in
   * global.css; there is no per-page opt-out. */
  surface?: 'light' | 'noir';
  ogImage?: string | undefined;
  /** Page-specific JSON-LD objects (§10) rendered after the sitewide
   * LocalBusiness — built only via src/lib/schema.ts builders. */
  jsonLd?: object[];
}

const { title, description, surface = 'light', ogImage, jsonLd: pageJsonLd = [] } = Astro.props;
const jsonLd = JSON.stringify(localBusiness());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} ogImage={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    {/* The one family (§13): this latin woff2 now serves body AND display,
        so the preload covers nearly all text on the page. */}
    <link rel="preload" href={playfairWoff2} as="font" type="font/woff2" crossorigin />
    {/* JSON-LD data blocks — is:inline states explicitly what Astro
        already infers (attribute-bearing scripts skip processing);
        CSP is unaffected: non-executable script types are data, not
        script-src subjects. External-audit Finding 7 housekeeping. */}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {pageJsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {analyticsOn && (
      <script
        is:inline
        defer
        data-domain={siteConfig.domain}
        data-api="https://plausible.io/api/event"
        src="/js/plausible.js"
      ></script>
    )}
    {/* Page-supplied head content (2026-09-03): the home concept's script
        tags ride this slot — static same-origin files only (script-src
        'self'); no page other than home uses it today. */}
    <slot name="head" />
  </head>
  <body
    class="min-h-dvh"
    data-surface={surface === 'noir' ? 'noir' : undefined}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-3 focus:text-black focus:underline"
    >
      Skip to content
    </a>
    <header>
      <slot name="header" />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <slot name="footer" />
    </footer>
  </body>
</html>
