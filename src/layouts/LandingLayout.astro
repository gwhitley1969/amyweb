---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import Footer from '../components/Footer.astro';
import StickyActions from '../components/StickyActions.astro';
import CTAButton from '../components/CTAButton.astro';
import DisclaimerBlock from '../components/DisclaimerBlock.astro';
import InvestigationalNotice from '../components/InvestigationalNotice.astro';
import BioteDisclaimer from '../components/BioteDisclaimer.astro';
import ProductDetailCards from '../components/ProductDetailCards.astro';
import EvolusLaurel from '../components/EvolusLaurel.astro';
import VisitSteps from '../components/VisitSteps.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import RouterCard from '../components/RouterCard.astro';
import TrustChips from '../components/TrustChips.astro';
import { siteConfig } from '../lib/siteConfig';
/* The home hero's portrait: Amy on her medspa counter, the one photo
 * approved for every page (the share card is made from it). */
import portrait from '../assets/photos/needlegirlie-hero.jpg';

/**
 * Ad landing page template — /go/<slug> (spec:
 * docs/superpowers/specs/2026-10-12-landing-pages-design.md; DECISIONS
 * 2026-10-12). The treatment page with its editorial tissue removed and
 * its two actions placed where a paid click expects them. Every string
 * here is the treatment entry's approved text, a siteConfig fact, or a
 * layout string TreatmentLayout already renders. The order is FIXED, as
 * it is there (CLAUDE.md hard constraint 3):
 *   eyebrow (place) -> H1 -> lead -> CTA row (chip Book + chip Call) ->
 *   portrait in the arch -> Evolus laurel (landing.ts rule) ->
 *   products -> flag-driven notices ADJACENT to products ->
 *   visit steps -> FAQ (landing.ts exclusions applied by the route) ->
 *   router card -> DisclaimerBlock (NEVER collapsed) ->
 *   noir CTA band + trust chips -> landing footer -> sticky bar (phones).
 * NOT rendered, by design: the deck, the MDX body, films, the entry's
 * photos, breadcrumbs, the primary nav, the practice badge. That is what
 * keeps every page-scoped operator override on its own page.
 * The page is noindex in every build (BaseLayout -> SeoHead) and out of
 * the sitemap (astro.config.mjs); the SWA templates add the header.
 * Zero client JS; one responsive image.
 */
type Treatment = CollectionEntry<'treatments'>['data'];

interface Props {
  title: string;
  /** The factual lead: `schemaDescription ?? summary` (the route decides). */
  lead: string;
  laurel: boolean;
  products: string[];
  productDetails: Treatment['productDetails'];
  ctaType: Treatment['ctaType'];
  investigational: boolean;
  investigationalProduct?: string | undefined;
  investigationalNote?: string | undefined;
  bioteDisclaimer: boolean;
  faq: Treatment['faq'];
  seo: Treatment['seo'];
}

const {
  title,
  lead,
  laurel,
  products,
  productDetails,
  ctaType,
  investigational,
  investigationalProduct,
  investigationalNote,
  bioteDisclaimer,
  faq,
  seo,
} = Astro.props;

/* On the light canvas no outline CTA renders (BUILD_SPEC §5): the row
 * under the lead wears the brand chip for both actions, the
 * /injector-training intro's pairing. */
const primary = ctaType === 'shop' ? 'shop' : 'consult';
---

<BaseLayout title={seo.title} description={seo.description} noindex>
  <Fragment slot="header">
    <LandingHeader />
  </Fragment>

  <article class="mx-auto max-w-3xl px-6 py-10 md:py-12">
    <div class="landing-hero">
      <div>
        <p class="eyebrow">{siteConfig.locality} · near Charlotte</p>
        <h1 class="heading-2 md:display-2 mt-3">{title}</h1>
        <hr class="rule-accent mt-4" />
        <p class="lead mt-6">{lead}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <CTAButton variant={primary} emphasis="chip" />
          <CTAButton variant="call" emphasis="chip" />
        </div>
      </div>
      <figure class="landing-portrait">
        <Image
          src={portrait}
          alt="Amy Palacios, FNP, seated on the counter of her Harrisburg medspa."
          widths={[320, 512, 640]}
          sizes="(max-width: 767px) 16rem, 18rem"
          loading="eager"
          fetchpriority="high"
          class="ng-arch"
        />
      </figure>
    </div>

    {laurel && <EvolusLaurel />}

    {
      productDetails.length > 0 ? (
        <>
          <h2 class="heading-3 mt-10">What Amy offers</h2>
          <ProductDetailCards items={productDetails} />
        </>
      ) : (
        products.length > 0 && (
          <>
            <h2 class="heading-3 mt-10">What Amy offers</h2>
            <ul class="mt-3 list-disc space-y-1 pl-6">
              {products.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </>
        )
      )
    }

    {/* Disclosures sit ADJACENT to the products they qualify — never below the fold of the copy. */}
    {investigational && <InvestigationalNotice productName={investigationalProduct} note={investigationalNote} />}
    {bioteDisclaimer && <BioteDisclaimer />}

    <div class="mt-12">
      <VisitSteps />
    </div>

    {
      faq.length > 0 && (
        <div class="mt-12">
          <FaqAccordion items={faq} />
        </div>
      )
    }

    <RouterCard />

    <DisclaimerBlock />
  </article>

  <div class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <h2 class="heading-2">
        Ready <span class="display-accent ng-shimmer">when you are</span>
      </h2>
      {/* The treatment pages' closing band, unchanged: primary CTA + Call
        * (the call variant is a tel: link, outline style). */}
      <div class="mt-6 flex flex-wrap items-center gap-4">
        {
          ctaType === 'book' ? (
            <CTAButton variant="book" />
          ) : ctaType === 'shop' ? (
            <CTAButton variant="shop" />
          ) : (
            <CTAButton variant="consult" />
          )
        }
        <CTAButton variant="call" />
      </div>
      <div class="mt-6">
        <TrustChips />
      </div>
    </div>
  </div>

  <Fragment slot="footer">
    <Footer variant="landing" />
    <StickyActions ctaType={ctaType} />
  </Fragment>
</BaseLayout>

<style is:global>
  /* Phones stack: text, then the portrait. From 768px the portrait sits
   * beside the headline and lead, so the first screen carries the face,
   * the words and both actions together. */
  .landing-hero {
    display: grid;
    gap: 2rem;
  }
  .landing-portrait {
    width: 16rem;
    max-width: 100%;
    margin: 0 auto;
  }
  @media (min-width: 48rem) {
    .landing-hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
    }
    .landing-portrait {
      width: 18rem;
      margin: 0;
      justify-self: end;
    }
  }
</style>
