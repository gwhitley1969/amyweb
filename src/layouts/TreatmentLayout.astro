---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import DisclaimerBlock from '../components/DisclaimerBlock.astro';
import InvestigationalNotice from '../components/InvestigationalNotice.astro';
import BioteDisclaimer from '../components/BioteDisclaimer.astro';
import DraftBanner from '../components/DraftBanner.astro';
import ProductDetailCards from '../components/ProductDetailCards.astro';
import EvolusLaurel from '../components/EvolusLaurel.astro';
import VisitSteps from '../components/VisitSteps.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import TrustChips from '../components/TrustChips.astro';

/**
 * Treatment page template (approved design plan + Mobbin-review addendum).
 * The compliance order is FIXED here — pages cannot reorder or opt out
 * (CLAUDE.md hard constraint 3):
 *   breadcrumbs -> H1 + underline run -> lead -> deck statement card
 *   (optional; replaced AtAGlance 2026-07-20, operator direction) ->
 *   Evolus laurel plaque (optional, frontmatter-gated — 2026-08-19,
 *   operator-approved; copy + authorization live in the component) ->
 *   intro -> products -> flag-driven notices ADJACENT to products -> body ->
 *   visit steps -> FAQ (only when items provided) -> pricing ->
 *   consult router -> DisclaimerBlock (light surface, NEVER collapsed) ->
 *   seam -> noir CTA band + trust chips.
 */
interface Props {
  title: string;
  summary: string;
  /** Editorial standfirst — one short, claims-clean display line shown
   * as the blush statement card under the lead. */
  deck?: string;
  /** Renders the EvolusLaurel ranking plaque between the deck and the
   * product cards (operator-authorized copy — see the component). */
  evolusLaurel?: boolean;
  products: string[];
  ctaType: 'book' | 'consult' | 'shop';
  investigational: boolean;
  bioteDisclaimer: boolean;
  pricingDisplay: 'none' | 'consult' | 'startingAt';
  clinicianApproved: boolean;
  investigationalProduct?: string;
  /** Page-supplied disclosure wording rendered inside InvestigationalNotice
   * — a single calm line from the content file; the component's bolded
   * default renders when absent. */
  investigationalNote?: string;
  /** When provided, renders ProductDetailCards in place of the products
   * bullet list — same slot in the fixed compliance order. */
  productDetails?: readonly {
    name: string;
    detail: string;
    tag?: string;
    priceLines?: readonly string[];
  }[];
  /** Editorial Q&A only — compliance text never goes in an accordion. */
  faq?: { q: string; a: string }[];
  seo: { title: string; description: string };
  /** Page JSON-LD (service + breadcrumbs) built by the route via
   * src/lib/schema.ts — forwarded to BaseLayout untouched. */
  jsonLd?: object[];
}

const {
  title,
  summary,
  deck,
  evolusLaurel = false,
  products,
  ctaType,
  investigational,
  bioteDisclaimer,
  pricingDisplay,
  clinicianApproved,
  investigationalProduct,
  investigationalNote,
  productDetails = [],
  faq = [],
  seo,
  jsonLd = [],
} = Astro.props;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: title, href: Astro.url.pathname },
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <Fragment slot="header">
    {!clinicianApproved && <DraftBanner />}
    <Header />
  </Fragment>

  <article class="mx-auto max-w-3xl px-6 py-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="heading-2 md:display-2 mt-6">{title}</h1>
    <hr class="rule-accent mt-4" />
    <p class="lead mt-6">{summary}</p>

    {deck && <p class="deck mt-8">{deck}</p>}

    {evolusLaurel && <EvolusLaurel />}

    <slot name="intro" />

    {
      productDetails.length > 0 ? (
        <>
          <h2 class="heading-3 mt-10">What Amy offers</h2>
          <ProductDetailCards items={productDetails} />
        </>
      ) : (
        products.length > 0 && (
          <>
            <h2 class="heading-3 mt-10">What Amy offers</h2>
            <ul class="mt-3 list-disc space-y-1 pl-6">
              {products.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </>
        )
      )
    }

    {/* Disclosures sit ADJACENT to the products they qualify — never below the fold of the copy. */}
    {investigational && <InvestigationalNotice productName={investigationalProduct} note={investigationalNote} />}
    {bioteDisclaimer && <BioteDisclaimer />}

    <div class="treatment-body">
      <slot />
    </div>

    <div class="mt-12">
      <VisitSteps />
    </div>

    {
      faq.length > 0 && (
        <div class="mt-12">
          <FaqAccordion items={faq} />
        </div>
      )
    }

    {
      pricingDisplay === 'consult' && (
        <p class="mt-8">Pricing is individual and discussed during your consultation.</p>
      )
    }

    <div class="router-card mt-10">
      <h2 class="heading-4">The right fit is a conversation.</h2>
      <p class="mt-2">Every plan is personal, decided with Amy in consultation.</p>
      <div class="mt-4">
        <CTAButton variant="consult" />
      </div>
    </div>

    <DisclaimerBlock />
  </article>

  <div class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <h2 class="heading-2">
        Ready <span class="display-accent ng-shimmer">when you are</span>
      </h2>
      {/* Primary CTA + Call, matching the /services, /about, and /visit
        * closing bands (the call variant is a tel: link, outline style). */}
      <div class="mt-6 flex flex-wrap items-center gap-4">
        {
          ctaType === 'book' ? (
            <CTAButton variant="book" />
          ) : ctaType === 'shop' ? (
            <CTAButton variant="shop" />
          ) : (
            <CTAButton variant="consult" />
          )
        }
        <CTAButton variant="call" />
      </div>
      <div class="mt-6">
        <TrustChips />
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  .router-card {
    background: var(--ng-card);
    border: 1px solid var(--ng-hairline);
    /* ink-pink edges on all boxes since 2026-07-22 (tokens.css
     * SITE-WIDE BOXES — magenta-600 is margin-thin on the card pink) */
    border-left: 1px solid var(--ng-ink-pink);
    padding: 1.5rem;
  }
  /* Editorial standfirst: the "jewelry" card carrying one display
   * line — replaced the AtAGlance fact table (2026-07-20). Upright
   * Playfair only (no italic face is loaded — keeps the font budget
   * untouched); ink-900 on the card pink 11.80:1, ink-pink edge 4.60:1
   * non-text (tokens.css SITE-WIDE BOXES). */
  .deck {
    background: var(--ng-card);
    border: 1px solid var(--ng-hairline);
    border-left: 2px solid var(--ng-ink-pink);
    padding: 1.5rem 1.75rem;
    font-family: var(--font-display);
    font-size: 1.5625rem;
    line-height: 1.4;
  }
  /* Element styles for MDX body content (C3): headings mirror the
   * heading-3 utility so collection prose sits on the type scale. */
  .treatment-body h2 {
    font-family: var(--font-body);
    font-size: 1.9375rem;
    line-height: 1.25;
    font-weight: 600;
    margin-top: 2.5rem;
  }
  .treatment-body p {
    margin-top: 0.75rem;
    max-width: 65ch;
  }
  /* Editorial media row for MDX bodies: a bare arched photo beside
   * copy, sitting straight on the ombre canvas — the /services look.
   * (Until 2026-08-18 these rendered as tilted white-matted prints;
   * the client asked for the mat gone and pink behind the arches —
   * the follow-up the arch rollout predicted. DECISIONS same date.)
   * Static, zero JS; the astro:assets pipeline sets width/height
   * (no CLS) and lazy-loads. */
  .treatment-body .media-row {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: 2.5rem;
  }
  @media (min-width: 40rem) {
    .treatment-body .media-row {
      grid-template-columns: 2fr 3fr;
    }
    .treatment-body .media-row--flip {
      grid-template-columns: 3fr 2fr;
    }
  }
  /* THE ARCH (sitewide motif, 2026-08-17) — a
   * documented mirror of .ng-arch (global.css): MDX bodies are plain
   * markup and can't take the class without content edits (which would
   * reset clinicianApproved), so the recipe lands by selector. Astro
   * derivative filenames keep the source basename, so the src-guard
   * excluding the lip style-guide (a labeled diagram — an arch or crop
   * would cut its six labels) is stable. The 4:5 display crop makes
   * every arch read as architecture: on a landscape box the 999px
   * radii resolve to a squat half-ellipse, not an arch. Same
   * derivatives are served — the crop is display-only, zero bytes.
   * ORDER CONTRACT: the .media-band rules below carry equal
   * specificity and must stay below this rule so their wider
   * aspect/position win on bands while the arch shape persists. */
  .treatment-body .media-figure img:not([src*='lip-style-guide']) {
    border-radius: 999px 999px 12px 12px;
    border: 1px solid var(--ng-magenta-600);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }
  /* Per-image crop override (the arch rollout's recorded knob — equal
   * specificity, must stay below the base rule): the wrinkle-relaxers
   * blazer frame anchors top so the 4:5 window keeps the neon letters
   * whole and both faces; the default 30% anchor sliced the script
   * mid-stroke. Sheds only legs at the bottom. */
  .treatment-body .media-figure img[src*='blazer-brow-injection'] {
    object-position: 50% 0%;
  }
  /* Full-width band — a page's third media moment breaks the
   * alternating row rhythm with scale instead of a third zigzag
   * (taste-audit follow-up, 2026-07-25): one wide arch across the
   * column. The wide crop via aspect-ratio keeps a portrait source
   * from towering; astro:assets still sets intrinsic dimensions, so
   * no CLS. */
  .treatment-body .media-band {
    margin-top: 2.5rem;
  }
  .treatment-body .media-band .media-figure {
    width: 100%;
    margin-top: 2rem;
  }
  /* Bands render as WIDE Roman arches: 9:8 is the widest frame whose
   * arch still reads as architecture (semicircle + visible straight
   * feet). Was 16:9 until the arch motif (2026-08-17) — a 16:9 box
   * turns the 999px radii into a half-ellipse lens. The one asset
   * that shipped a baked 16:9 derivative through this 9:8 window
   * (fine-gauge-detail, a recorded double-crop defect) retired
   * 2026-08-18 with the wrinkle-relaxers photo round — its
   * replacement is a baked 9:8 re-cut that matches the window
   * exactly, so today object-fit is the degrade path everywhere. */
  .treatment-body .media-band .media-figure img {
    aspect-ratio: 9 / 8;
    object-fit: cover;
    object-position: 50% 42%;
  }
  /* Tall band variant (regenerative, 2026-07-26): since the 2026-08-17
   * base-band change both bands share 9:8 — for prp-treatment it
   * matches the server-side crop exactly, so object-fit is inert and
   * stays only as the degrade path. The variant survives as the
   * centered-composition contract (50% 50%). Equal specificity to the
   * rules above — it must stay below them to win. */
  .treatment-body .media-band--tall .media-figure img {
    aspect-ratio: 9 / 8;
    object-position: 50% 50%;
  }
  /* Segmental band variant (wrinkle-relaxers, 2026-08-18 — client
   * feedback: "we need to see everyone in the picture"): the frame's
   * people span wider than any 9:8 window (geometry in DECISIONS,
   * same date), a 9:8 crop loses a person and the blur-fill read
   * as not fitting — so the ARCH changes shape instead: a designed
   * segmental arch (architecture's wide sibling of the Roman arch) at
   * the photo's own 3:2, curve pinned to the top ~third with straight
   * feet below. NOT the recorded 16:9 "lens" failure — that was the
   * accidental full-height ellipse with NO feet; the pinned vertical
   * radius keeps feet, hairline, and 12px foot corners. The full
   * frame fills the window: everyone visible, no crop, no fill.
   * Equal specificity to the band rules above — order wins. */
  .treatment-body .media-band--segmental .media-figure img {
    aspect-ratio: 3 / 2;
    border-radius: 50% 50% 12px 12px / 34% 34% 12px 12px;
  }
  /* The bare figure: no mat, no tilt — the white paper mat + ±1.5deg
   * print lean retired 2026-08-18 (client direction: pink behind the
   * arches, like /services). The arch hairline on the img is the only
   * frame. */
  .treatment-body .media-figure {
    justify-self: center;
    width: min(18rem, 100%);
  }
  .treatment-body .media-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .treatment-body .media-figure figcaption {
    margin-top: 0.5rem;
    text-align: center;
  }
  .treatment-body .media-copy h2 {
    margin-top: 0;
  }
</style>
