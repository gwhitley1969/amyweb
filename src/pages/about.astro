---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAButton from '../components/CTAButton.astro';
import TrustChips from '../components/TrustChips.astro';
import EvolusLaurel from '../components/EvolusLaurel.astro';
import TreatmentVideo from '../components/TreatmentVideo.astro';
import { siteConfig } from '../lib/siteConfig';
import familyPortrait from '../assets/photos/family-portrait.jpg';
import iconPoster from '../assets/photos/evolus-icon-poster.jpg';
import studioNeonPortrait from '../assets/photos/studio-neon-portrait.jpg';
import girlTeamStudio from '../assets/photos/girl-team-studio.jpg';
import commercialTeamPoster from '../assets/photos/commercial-team-poster.jpg';

/**
 * /about — the magazine profile (full rebuild 2026-08-03; DECISIONS same
 * date). Five beats: hero, milestones timeline, the studio/name section,
 * booking prose, closing band. Every sentence traces to the record —
 * career facts from the operator-supplied provider-directory listing
 * (2026-07-19: two decades of nursing, much critical care; aesthetics
 * 2017; nurse practitioner 2018; FNP, BSN; Biote-certified) — wording
 * CONFIRMED by Amy on the PR #83 preview, 2026-08-04: the standing
 * 2026-07-19 confirmation flag is resolved (DECISIONS 2026-08-04).
 * Sole ownership of Mobile Aesthetics:
 * DECISIONS 2026-07-23. "AKA Needle Girlie": the client-dictated byline,
 * DECISIONS 2026-07-30. The "Inside Evolus" film lives here since
 * 2026-08-18 (client direction, moved from /services/wrinkle-relaxers
 * with the recognition plate — supersedes the 2026-07-21 "About is
 * ranking-free" placement decision; DECISIONS 2026-08-18); the plate
 * gave way to the EvolusLaurel ranking plaque 2026-08-25 (client
 * direction, the dermal-fillers-precedent swap; the plate's allowlist
 * entry withdrawn, its ranking vocabulary banned everywhere again —
 * DECISIONS same date). The
 * multi-provider location gets its one factual line in prose; since
 * 2026-08-25 the milestones section also carries the Girl Team still
 * and the second yourmobileaesthetics.com link, both under the fourth
 * constraint-2 scoped operator override, direct from Amy (DECISIONS
 * same date — see the figure comment below), and — later the same
 * day — the team film below the button in a sounded rendition, the
 * constraint-2 SECOND exception (the carousel team film) widened to
 * this placement (DECISIONS 2026-08-25; see the film comment below).
 * Hero portrait is Amy's family (client-requested
 * 2026-07-23; on-record consent covers everyone pictured incl. the
 * minors); alt text names no one but Amy. The studio photo (8K0A9862)
 * publishes uncropped with the legible "MobileAesthetics" neon — her own
 * signage, the prp-treatment precedent; a brand call, ACCEPTED with
 * Amy's 2026-08-04 approval and still reversible on her word
 * (DECISIONS 2026-08-03 and 2026-08-04). The hero lead's em dash is on the
 * 2026-07-29 keep-list: byte-identical, and never echo its construction
 * in new copy on this page.
 */

/* MA chevron plate data — hand-copied VERBATIM 2026-08-26 from
 * VisitSteps.astro (which copied it from
 * src/assets/brand/mobile-aesthetics-mark-header.svg 2026-08-19;
 * brand fidelity — MA is Amy's own PLLC, constraint 2 not engaged,
 * DECISIONS 2026-07-23). Operator direction (mockup chevrons02.png):
 * the milestones' Playfair numerals retire for the same plates the
 * treatment pages' VisitSteps wears — superseding the 2026-08-19
 * "the /about milestones keep their numerals" scoping (DECISIONS
 * 2026-08-26). Gradient ids are about-foil-0…3 — their own
 * namespace, indexed so no page carries duplicate ids (axe). The
 * badges are decorative (aria-hidden), and NO sr-only ordinal joins
 * the headings — a deliberate asymmetry with VisitSteps' "Step N.":
 * step numbers carry meaning in a process list but would misdescribe
 * a biography timeline whose headings carry the years; the <ol>
 * semantics announce order and count as before (DECISIONS
 * 2026-08-26). */
const FOIL_STOPS = [
  ['0.00', '#fdaedb'],
  ['0.13', '#fda6d8'],
  ['0.38', '#fd78d4'],
  ['0.63', '#e967b6'],
  ['0.88', '#fc9ad6'],
  ['1.00', '#fdaad9'],
];
const CHEVRONS = [
  'M24.19 108.00 L42.19 108.00 L89.49 158.98 L42.16 210.00 L24.16 210.00 L71.49 158.98 Z',
  'M84.99 108.00 L102.99 108.00 L150.28 158.98 L102.95 210.00 L84.95 210.00 L132.28 158.98 Z',
  'M146.07 108.00 L164.07 108.00 L211.36 158.98 L164.04 210.00 L146.04 210.00 L193.36 158.98 Z',
  'M207.02 108.00 L225.02 108.00 L272.32 158.98 L224.99 210.00 L206.99 210.00 L254.32 158.98 Z',
];
---

<BaseLayout
  title="About Amy Palacios, FNP | Needle Girlie"
  description="Amy Palacios, FNP: two decades of nursing, owner of Mobile Aesthetics, Biote-certified. The one clinician behind every Needle Girlie appointment in Harrisburg, NC."
>
  <Header slot="header" />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid items-start gap-10 md:grid-cols-[6fr_5fr]">
      <div>
        <p class="eyebrow">About</p>
        <hr class="rule-accent mt-4" aria-hidden="true" />
        <h1 class="display-2 mt-6">Amy Palacios, FNP</h1>
        <p class="lead mt-6">
          Needle Girlie is the work of one clinician. Every consultation,
          every plan, every appointment — Amy herself.
        </p>
        <div class="mt-8 max-w-prose space-y-4">
          <p>
            Before the studio, there was the hospital floor. Amy spent two
            decades in nursing, much of it in critical care, where getting
            every detail right isn't a flourish. It's the job.
          </p>
          <p>
            She brought that training into medical aesthetics in 2017 and
            became a nurse practitioner the following year.
          </p>
          <p>
            Today the studio is hers: Amy owns Mobile Aesthetics in
            Harrisburg, North Carolina, just northeast of Charlotte. She
            practices there alongside other independent providers, and
            Needle Girlie is the dedicated home of her own work.
          </p>
        </div>
        <div class="mt-8">
          <CTAButton variant="consult" />
        </div>
      </div>
      <figure class="about-portrait ng-arch">
        <Image
          src={familyPortrait}
          alt="Amy Palacios, FNP, with her family."
          widths={[480, 760, 1080]}
          sizes="(min-width: 768px) 40vw, 90vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20"
    aria-labelledby="about-milestones-title"
  >
    <hr class="rule-accent ng-trace" aria-hidden="true" />
    <div class="mt-6 grid items-start gap-10 md:grid-cols-[5fr_6fr]">
      <div>
        <h2 class="heading-2" id="about-milestones-title">
          Two decades in the making.
        </h2>
        <ol class="about-milestones mt-8 max-w-3xl" role="list">
          <li class="about-milestones__step ng-rise">
            <div class="about-milestones__badge" aria-hidden="true">
              <svg viewBox="24.16 108 248.16 102" fill="none">
                <defs>
                  <linearGradient id="about-foil-0" gradientUnits="userSpaceOnUse" x1="24" y1="0" x2="271" y2="0">
                    {FOIL_STOPS.map(([off, color]) => (
                      <stop offset={off} stop-color={color} />
                    ))}
                  </linearGradient>
                </defs>
                {CHEVRONS.map((d) => (
                  <path d={d} fill="url(#about-foil-0)" />
                ))}
              </svg>
            </div>
            <div>
              <h3 class="heading-4">The bedside years</h3>
              <p class="mt-2">Two decades of nursing, much of it in critical care.</p>
            </div>
          </li>
          <li class="about-milestones__step ng-rise">
            <div class="about-milestones__badge" aria-hidden="true">
              <svg viewBox="24.16 108 248.16 102" fill="none">
                <defs>
                  <linearGradient id="about-foil-1" gradientUnits="userSpaceOnUse" x1="24" y1="0" x2="271" y2="0">
                    {FOIL_STOPS.map(([off, color]) => (
                      <stop offset={off} stop-color={color} />
                    ))}
                  </linearGradient>
                </defs>
                {CHEVRONS.map((d) => (
                  <path d={d} fill="url(#about-foil-1)" />
                ))}
              </svg>
            </div>
            <div>
              <h3 class="heading-4">2017 &middot; Aesthetics</h3>
              <p class="mt-2">Amy moves from the hospital into medical aesthetics.</p>
            </div>
          </li>
          <li class="about-milestones__step ng-rise">
            <div class="about-milestones__badge" aria-hidden="true">
              <svg viewBox="24.16 108 248.16 102" fill="none">
                <defs>
                  <linearGradient id="about-foil-2" gradientUnits="userSpaceOnUse" x1="24" y1="0" x2="271" y2="0">
                    {FOIL_STOPS.map(([off, color]) => (
                      <stop offset={off} stop-color={color} />
                    ))}
                  </linearGradient>
                </defs>
                {CHEVRONS.map((d) => (
                  <path d={d} fill="url(#about-foil-2)" />
                ))}
              </svg>
            </div>
            <div>
              <h3 class="heading-4">2018 &middot; Nurse practitioner</h3>
              <p class="mt-2">The credential reads FNP, BSN.</p>
            </div>
          </li>
          <li class="about-milestones__step ng-rise">
            <div class="about-milestones__badge" aria-hidden="true">
              <svg viewBox="24.16 108 248.16 102" fill="none">
                <defs>
                  <linearGradient id="about-foil-3" gradientUnits="userSpaceOnUse" x1="24" y1="0" x2="271" y2="0">
                    {FOIL_STOPS.map(([off, color]) => (
                      <stop offset={off} stop-color={color} />
                    ))}
                  </linearGradient>
                </defs>
                {CHEVRONS.map((d) => (
                  <path d={d} fill="url(#about-foil-3)" />
                ))}
              </svg>
            </div>
            <div>
              <h3 class="heading-4">Today &middot; Needle Girlie</h3>
              <p class="mt-2">
                Owner of Mobile Aesthetics, a Biote-certified provider, and the
                one clinician behind every Needle Girlie appointment.
              </p>
            </div>
          </li>
        </ol>
      </div>
      {/* Girl Team still (29b, 2026-08-25): Amy center with FOUR of the
        * location's five other providers — a hard-constraint-2 operator
        * override direct from Amy, the fourth scoped exception (DECISIONS
        * 2026-08-25; CLAUDE.md constraint 2). All four pictured providers'
        * releases for needlegirlie.com use confirmed on file (operator,
        * same date). No signage or claims text in frame; nobody is named
        * in copy or alt. The plate is the site's FIRST text-over-photo —
        * opaque per the Phase C a11y rule (no scrims), Amy's casing kept
        * (no uppercase transform). The arch is the segmental recipe
        * hand-copied from TreatmentLayout (see the style block). The
        * button below is the SECOND sanctioned yourmobileaesthetics.com
        * link (the header badge, 2026-08-15, was the first) — same
        * destination, same ma_site_click event. */}
      <div class="md:order-first">
        <figure class="about-team ng-rise">
          <figcaption class="about-team__plate">Girl Team!</figcaption>
          <Image
            src={girlTeamStudio}
            alt="Amy with the Mobile Aesthetics team, standing together in a white studio."
            widths={[480, 760, 1080]}
            sizes="(min-width: 768px) 42vw, 90vw"
            loading="lazy"
          />
        </figure>
        <div class="mt-6">
          <a
            href={siteConfig.mobileAestheticsUrl}
            class="cta cta--outline"
            target="_blank"
            rel="noopener"
            data-event="ma_site_click"
          >
            Visit Mobile Aesthetics
            <span class="chev-nudge" aria-hidden="true">&rsaquo;</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
        {/* The team film (2026-08-25): the same Mobile Aesthetics team
          * film the home carousel plays — the location's other five
          * providers on camera — here in a sounded rendition
          * (girl-team-film.mp4). The constraint-2 SECOND scoped
          * exception (the carousel team film, 2026-08-17) is widened to
          * this placement at the client's direction; the five
          * providers' releases confirmed on file 2026-08-17 cover the
          * film (DECISIONS 2026-08-25). Site-authored and speech-free
          * (music bed only — the operator's 2026-08-25 confirmation is
          * the record), so autoplay="inview" is IN-CONTRACT here,
          * unlike the ICON film's scoped override below: muted on
          * approach, loops on screen, the music one tap away on the
          * native controls; reduced motion = click-to-play. The label
          * shares the unit's factual team naming (fourth-exception
          * terms); no printed caption (the 2026-08-21 rule). */}
        <div class="about-team-film">
          <TreatmentVideo
            src="/media/girl-team-film.mp4"
            poster={commercialTeamPoster}
            captionsSrc="/media/girl-team-film.vtt"
            label="The Mobile Aesthetics team film — the team under the studio neon and a black-and-white photo-shoot montage"
            frame="bare"
            autoplay="inview"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Evolus ranking + the ICON film. The film moved here from
    * /services/wrinkle-relaxers at the client's direction (2026-08-18,
    * DECISIONS same date); the recognition plate came with it, and on
    * 2026-08-25 gave way to the EvolusLaurel ranking plaque (client
    * direction — the dermal-fillers-precedent plate-for-plaque swap,
    * DECISIONS same date). The plaque's two sentences are
    * operator-authorized superiority copy scoped to exactly three
    * pages, /about now among them (CLAUDE.md constraint 3; the
    * component header carries the rules). The retired plate's
    * allowlist entry is WITHDRAWN — its ranking vocabulary is banned
    * everywhere again, comments included. The film intro paragraph,
    * label, and caption are byte-identical to the treatment page's.
    * Content sits in a left-aligned max-w-3xl column (the milestones
    * idiom) — the width both components shipped in inside the
    * treatment body. The film player stays exempt from the arch motif
    * (players never mask manufacturer footage — DECISIONS 2026-08-17). */}
  <section
    class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20"
    aria-labelledby="about-evolus-title"
  >
    <div class="max-w-3xl">
      <EvolusLaurel />
      <hr class="rule-accent ng-trace mt-12 sm:mt-16" aria-hidden="true" />
      <h2 class="heading-2 mt-6" id="about-evolus-title">Inside Evolus</h2>
      <p class="mt-6 max-w-prose">
        Evolus brought providers from across the country to its Newport
        Beach headquarters for its first ICON experience. Amy was in the
        room. This is Evolus's own recap of the event.
      </p>
      {/* autoplay="inview" here is a scoped operator override
        * (2026-08-25, DECISIONS same date) of the 2026-08-21 rule that
        * narrated manufacturer films never autoplay — flagged, and the
        * client chose autoplay. Muted on approach, loop while on
        * screen, tap for sound (the caption's "sound on" is that
        * nudge); reduced motion = click-to-play. */}
      <TreatmentVideo
        src="/media/evolus-icon.mp4"
        poster={iconPoster}
        captionsSrc="/media/evolus-icon.vtt"
        label="ICON — an Evolus HQ experience: Evolus's recap of its provider event"
        caption="ICON — an Evolus HQ experience. An Evolus production — sound on."
        autoplay="inview"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
    <div class="grid items-center gap-10 md:grid-cols-[3fr_2fr]">
      <div>
        <hr class="rule-accent ng-trace" aria-hidden="true" />
        <h2 class="heading-2 mt-6">The name on the wall.</h2>
        <div class="mt-6 max-w-prose space-y-4">
          <p>
            The neon script over the studio reads Mobile Aesthetics — Amy's
            own practice. Needle Girlie is the name she goes by, and this
            site exists so there is zero confusion about who you are booking
            with: one clinician, under her own sign.
          </p>
          <p>
            Twelve lines of service run through the studio, from injectables
            to skin, body, and wellness, and Amy performs every one of them.
            <a href="/services">Explore all twelve <span class="chev-nudge" aria-hidden="true">&rsaquo;</span></a>
          </p>
        </div>
        <h3 class="heading-4 mt-10">Booked your way.</h3>
        <p class="mt-2 max-w-prose">
          Book an appointment whenever you are ready, or start with a free
          consultation, available upon request. Either way, the plan is
          personal, and it is made with Amy.
        </p>
      </div>
      <figure class="about-print ng-rise">
        {/* the img itself wears the arch — a matted arch print: the
          * white matte, tilt, and shadow stay on the figure */}
        <Image
          src={studioNeonPortrait}
          alt="Amy Palacios, FNP, in her studio beneath the Mobile Aesthetics neon sign."
          widths={[360, 520, 760]}
          sizes="18rem"
          loading="lazy"
          class="ng-arch"
        />
      </figure>
    </div>
  </section>

  <section class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <p class="eyebrow">Appointments</p>
      <h2 class="display-2 mt-4">
        Ready <span class="display-accent ng-shimmer">when you are</span>.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <CTAButton variant="book" />
        <CTAButton variant="call" />
      </div>
      <div class="mt-8">
        <TrustChips />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  /* Same light-wash grade as the /services strip. Frame shape + border
   * come from .ng-arch (global.css) — the sitewide arch motif,
   * 2026-08-17. */
  .about-portrait {
    position: relative;
    margin: 0;
  }
  .about-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* group portrait: faces sit mid-frame, not top-of-frame like the
     * old single-subject shot — anchor the crop to the group */
    object-position: 50% 38%;
    filter: grayscale(15%) contrast(1.03) brightness(1.05);
  }
  .about-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ng-magenta-600) 10%, transparent);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  /* Milestones — the MA chevron plates (operator direction 2026-08-26,
   * mockup chevrons02.png), replacing the Playfair-counter recipe
   * hand-copied 2026-08-15 from VisitSteps: the same
   * numerals-for-plates retirement VisitSteps made 2026-08-19, which
   * closes the counter recipe's last live use AND the display
   * accent's last light-canvas consumer (tokens.css OMBRE CANVAS
   * record updated; the re-ink stays). Plate rules hand-copied from
   * VisitSteps.astro — the same hand-copy precedent as the counter
   * before it (DECISIONS 2026-08-26). */
  .about-milestones {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .about-milestones__step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
  }
  /* Hairline rules separate the steps (editorial table rhythm). */
  .about-milestones__step + .about-milestones__step {
    border-top: 1px solid var(--ng-hairline);
    padding-top: 2rem;
  }
  /* The MA chevron plate — noir by design (the mark's own plate
   * anatomy); decorative, so no contrast pair is engaged. Width
   * matches VisitSteps for cross-page consistency. */
  .about-milestones__badge {
    background: var(--ng-noir);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    width: 7rem;
    align-self: start;
  }
  .about-milestones__badge svg {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 400px) {
    .about-milestones__step {
      grid-template-columns: 1fr;
      row-gap: 0.5rem;
    }
  }
  /* Girl Team figure — the segmental arch, hand-copied from
   * TreatmentLayout .media-band--segmental (scoped to .treatment-body
   * there, unreachable here — the same hand-copy precedent as
   * .about-print below): the wide sibling of the Roman arch at the
   * photo's own 3:2, curve pinned to the top third, straight feet,
   * 12px foot corners. Landscape frames that must show full content
   * wear this shape (2026-08-18); every photo wears an arch (Amy's
   * sitewide direction, 2026-08-17). Same light wash as
   * .about-portrait; the ::after mirrors the arch radius because no
   * overflow clip runs on the figure here. */
  .about-team {
    position: relative;
    margin: 0;
  }
  .about-team img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 50% 50% 12px 12px / 34% 34% 12px 12px;
    border: 1px solid var(--ng-magenta-600);
    filter: grayscale(15%) contrast(1.03) brightness(1.05);
  }
  .about-team::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50% 50% 12px 12px / 34% 34% 12px 12px;
    background: color-mix(in srgb, var(--ng-magenta-600) 10%, transparent);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  /* The plate — the site's first text-over-photo, an OPAQUE paper
   * plate per the Phase C a11y rule (never a scrim). z-index lifts it
   * above the ::after wash so the paper stays untinted and the text
   * audits at its real contrast (raw ink-900 on paper — the in-tile
   * idiom, same as the skincare QR tile). True keystone: the plate
   * straddles the arch crown (negative top, half above the edge), so
   * it clears every face at EVERY viewport — a %-offset plate grew
   * into Amy's hair at 390px, since Amy stands center under a
   * centered plate. Amy's own casing — no uppercase transform. */
  .about-team__plate {
    position: absolute;
    top: -0.875rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    background: var(--ng-paper);
    border: 1px solid var(--ng-hairline);
    border-radius: 2px;
    padding: 0.375rem 0.875rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ng-ink-900);
    white-space: nowrap;
  }
  /* Team film — portrait 9:16, capped at the treatment pages' in-row
   * film width (that sizing rule is scoped to .treatment-body in
   * TreatmentLayout, unreachable here — the page's standing hand-copy
   * precedent). The TreatmentVideo figure fills its container, so the
   * wrapper is the knob; the figure's own 2.5rem margin-top is the
   * gap under the button. */
  .about-team-film {
    width: min(18rem, 100%);
  }
  /* Framed print — the house white-matte small print, hand-copied from
   * TreatmentLayout .media-figure (scoped to .treatment-body there,
   * unreachable here). Right-hand figure beside copy takes the flip
   * tilt (+1.5deg): prints lean toward the copy. ng-rise composes —
   * it animates translate; the tilt is transform. */
  .about-print {
    justify-self: center;
    width: min(18rem, 100%);
    margin: 0;
    background: var(--ng-paper);
    border: 1px solid var(--ng-hairline);
    padding: 0.625rem;
    box-shadow: 0 14px 28px -16px color-mix(in srgb, var(--ng-ink-900) 40%, transparent);
    transform: rotate(1.5deg);
  }
  .about-print img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
