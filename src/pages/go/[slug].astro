---
import { getCollection } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import { LANDING_SLUGS, landingRules } from '../../lib/landing';

/**
 * Ad landing pages — /go/<slug> (spec:
 * docs/superpowers/specs/2026-10-12-landing-pages-design.md and its §13;
 * DECISIONS 2026-10-12 and 2026-10-13). One page per slug in
 * src/lib/landing.ts, each rendering its treatment entry's approved
 * frontmatter through LandingLayout under that file's per-page rules
 * (the plaque, FAQ exclusions, which field is the lead). The MDX body is
 * never rendered here. Pages are noindex in every build and absent from
 * the sitemap; adding a line is a list edit plus its .pa11yci.json line.
 */
export async function getStaticPaths() {
  const treatments = await getCollection('treatments', ({ data }) => !data.draft);
  return LANDING_SLUGS.map((slug) => {
    const entry = treatments.find((e) => e.id === slug);
    if (!entry) throw new Error(`landing: no non-draft treatment entry for "${slug}"`);
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const rules = landingRules(entry.id);

// A listed exclusion that no longer matches a question fails the build,
// so a rule that honours a page-scoped exception cannot rot silently.
for (const q of rules.faqExclude) {
  if (!entry.data.faq.some((item) => item.q === q)) {
    throw new Error(`landing: "${entry.id}" has no FAQ question "${q}" to exclude`);
  }
}
const faq = entry.data.faq.filter((item) => !rules.faqExclude.includes(item.q));

// A `summary` lead rule only means something where a schemaDescription
// exists (without one the default already renders the summary); a stale
// rule fails the build rather than sitting there inert.
if (rules.lead === 'summary' && !entry.data.schemaDescription) {
  throw new Error(`landing: "${entry.id}" has a summary-lead rule but no schemaDescription`);
}
const lead =
  rules.lead === 'summary' ? entry.data.summary : (entry.data.schemaDescription ?? entry.data.summary);
---

<LandingLayout
  title={entry.data.title}
  lead={lead}
  laurel={rules.laurel}
  products={[...entry.data.products]}
  productDetails={entry.data.productDetails}
  ctaType={entry.data.ctaType}
  investigational={entry.data.investigational}
  investigationalProduct={entry.data.investigationalProduct}
  investigationalNote={entry.data.investigationalNote}
  bioteDisclaimer={entry.data.bioteDisclaimer}
  faq={faq}
  seo={entry.data.seo}
/>
