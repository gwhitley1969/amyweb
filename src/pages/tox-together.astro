---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAButton from '../components/CTAButton.astro';
import ReviewNumber from '../components/ReviewNumber.astro';
import { reviewTag } from '../lib/reviewTags';
import { siteConfig } from '../lib/siteConfig';
import { service } from '../lib/schema';

/**
 * /tox-together — Tox Together, the private-party page (added
 * 2026-09-26 at the operator's direction as /tox-to-go, "Tox To Go";
 * renamed and moved 2026-09-27, the operator again — DECISIONS both
 * dates; production never served the old address, so no redirect).
 * It REPLACES /mobile (2026-09-02 → 2026-09-26; deleted
 * outright, the /book precedent — production never served it, so no
 * redirect). The home band (ConceptHome) is this page's door: the
 * name, the tagline, one sentence, the same call button and a link
 * here. Built on the standalone-page pattern (/injector-training;
 * /visit's one-column opening): a src/pages route outside the
 * treatments collection, so no clinicianApproved flag gates it — Amy
 * reviews it via the non-gated section of docs/CLINICIAN-SIGN-OFF.md.
 *
 * Rules in force for future edits:
 * - THE WORDS ARE THE OPERATOR'S DOCUMENT, AS WRITTEN. Every sentence
 *   of copy — the offer, the $600 hostess credit, the three
 *   requirements, the tagline — is the operator's own Tox To Go
 *   document, reproduced without rephrasing (headings sentence-cased,
 *   the one house change; the two eyebrows and the heading's "Party" —
 *   the operator's direction on the preview, 2026-09-26 — are the only
 *   added words; the name reads "Tox Together" wherever the document
 *   says "Tox To Go" — the operator's rename, 2026-09-27).
 *   The figures are the operator's, not the site's (constraint 7:
 *   nothing here is invented). Do not change a word without the
 *   operator; the home band carries the same lead and sentence, so the
 *   two change together. Amy confirms the terms before the merge.
 * - "Tox" — the neuromodulator shorthand Amy's posts use — is allowed
 *   on this page by operator override after the flag (2026-09-26): in
 *   the copy, the title, the meta description (so the OG tags), the
 *   JSON-LD name, the URL and the nav label. It appears on no other
 *   page. The competitor brand name her captions pair it with never
 *   appears on this site — copy, alt, comments, meta, JSON-LD.
 * - "Party" is the client's own word, allowed by operator decision
 *   (2026-09-02, flagged once — injectable gatherings draw board
 *   scrutiny in several states; the flag stands on the record).
 * - Contact is the phone: "Book your Tox Together party" is the call
 *   variant wearing the document's line, the number printed under it
 *   for screens that cannot place a call. Not "Book with Amy"
 *   (reserved for Vagaro buttons), and BookLink never renders here
 *   (its header names this page). A consultation sentence was offered
 *   and declined (2026-09-26): the copy answers no suitability
 *   question, and nothing on this page decides anyone's fit.
 * - No photo and no film. /mobile's van-interior photo and viewfinder
 *   film were offered for this page and declined by the operator; they
 *   left the repo with that page (the film's Blob object stays on the
 *   media origin, unreferenced; the seated guest's release stays on
 *   file). The page carries itself on type and its surfaces, and loads
 *   no script of its own.
 * - Surfaces. The offer sits on a mid-page NOIR band so its accent
 *   phrase can wear the display accent (re-inked to ink-900 on the
 *   ombre canvas, where it would vanish) with the shimmer (noir
 *   display-accent phrases only, at or above the 39px floor — the h2
 *   never drops below heading-2). The plates on it are static boxes —
 *   hairline, transparent card, no elevation — and their numerals are
 *   decoration (aria-hidden): all three requirements apply, so nothing
 *   is lost when a reader never hears the numbers.
 */

const pageTitle = 'Tox Together: Private Tox Parties at Home | Needle Girlie';
const pageDescription =
  'Host a private Tox Party at home with Amy Palacios, FNP, around Charlotte, NC. When your Tox Together party qualifies, you receive a $600 service credit.';

// REVIEW SCAFFOLDING (ReviewNumber.astro) — letter tag for this route.
const reviewPageTag = reviewTag(Astro.url.pathname);

const jsonLd = [
  service(
    'Tox Together',
    'Private Tox Parties at home: Amy Palacios, FNP, brings the Tox experience to gatherings of friends and family around Charlotte, NC.',
    `${siteConfig.url}/tox-together`,
  ),
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Header slot="header" />

  {/* ---- THE OPENING (ombre canvas), one column — /visit's hero shape.
      With no photo, the largest paint is the h1 itself, so the page
      needs none of /mobile's LCP tuning. The h1 takes the larger
      display size from md: three short words carry it. ---- */}
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    {reviewPageTag && <ReviewNumber n={reviewPageTag} />}
    <p class="eyebrow">Private parties</p>
    <hr class="rule-accent mt-4" aria-hidden="true" />
    <h1 class="display-2 md:display-1 mt-6">Tox Together Party</h1>
    <p class="lead mt-6">Your place. Your people. Your glow.</p>
    <div class="mt-8 max-w-prose space-y-4">
      <p>Turn your next get-together into a little something extra.</p>
      <p>
        With Tox Together, you can host a private Tox Party for your friends and
        family in the comfort of your own home. Gather your favorite people,
        enjoy time together, and Amy will bring the Tox experience to you.
      </p>
    </div>
    <div class="mt-8">
      <CTAButton variant="call" emphasis="chip" label="Book your Tox Together party" />
      <p class="tox-phone">{siteConfig.phone}</p>
    </div>
  </section>

  {/* ---- THE OFFER (noir): the hostess credit and the three
      requirements, the document's own words — the operator's pick over
      the plain canvas. The credit wears the display accent and the
      shimmer (pink-300 on noir, 11.58:1; the h2 is heading-2 at every
      width, the accent's 39px floor, and display-2 from md). The plates
      are static boxes on noir — hairline, transparent card, no
      elevation (tokens.css: never on a static box); 01/02/03 are
      decoration (aria-hidden). They rise in sequence on approach (the
      house move for a row of plates; stilled under reduced motion).
      ---- */}
  <section class="surface" data-surface="noir" aria-labelledby="tox-offer-title">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <h2 class="heading-2 md:display-2" id="tox-offer-title">
        Hostess&nbsp;perk: <span class="display-accent ng-shimmer">$600 Service Credit</span>
      </h2>
      <p class="lead mt-6 max-w-prose">
        Hosting has its rewards! When your Tox Together party meets the
        qualifying requirements, you receive a $600 credit toward
        services as Amy's thank-you for bringing everyone together.
      </p>
      <h3 class="heading-3 mt-12">Party requirements</h3>
      <p class="mt-3">To qualify for the Hostess Service Credit:</p>
      <ol role="list" class="tox-plates mt-6 grid gap-4 sm:grid-cols-3">
        <li class="tox-plate ng-rise">
          <span class="tox-plate__num" aria-hidden="true">01</span>
          <p class="mt-3">Minimum of 7 guests</p>
        </li>
        <li class="tox-plate ng-rise ng-rise-2">
          <span class="tox-plate__num" aria-hidden="true">02</span>
          <p class="mt-3">Average service purchase of $300 per guest</p>
        </li>
        <li class="tox-plate ng-rise ng-rise-3">
          <span class="tox-plate__num" aria-hidden="true">03</span>
          <p class="mt-3">Services are provided during your scheduled private Tox Together event</p>
        </li>
      </ol>
      <p class="lead mt-8 max-w-prose">
        That's a minimum of $2,100 in services among your guests—and a $600
        Service Credit for you.
      </p>
    </div>
  </section>

  {/* ---- GATHER (canvas): the document's closing paragraph as a
      two-column split — the heading left, the paragraph right at lead
      size — the width filled without media. ---- */}
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20" aria-labelledby="tox-gather-title">
    <div class="grid items-start gap-10 md:grid-cols-[5fr_6fr]">
      <div>
        <hr class="rule-accent ng-trace" aria-hidden="true" />
        <h2 class="heading-2 md:display-2 mt-6" id="tox-gather-title">
          Gather your people. Amy will come to you.
        </h2>
      </div>
      <p class="lead md:mt-6">
        No waiting room. No coordinating everyone's schedule around a trip to
        the office. Just invite your friends and family, choose your location,
        and make an event of it.
      </p>
    </div>
  </section>

  {/* ---- CLOSING (noir): the sitewide bookend — the document's tagline
      as the two-tone headline, its accent phrase carrying the shimmer,
      and the call with the number under it. ---- */}
  <section class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <p class="eyebrow">Tox Together</p>
      <h2 class="display-2 mt-4">
        Your&nbsp;place. Your&nbsp;people.<br />
        <span class="display-accent ng-shimmer">Your glow.</span>
      </h2>
      <p class="lead mt-6">Ready to host?</p>
      <div class="mt-8">
        <CTAButton variant="call" label="Book your Tox Together party" />
        <p class="tox-phone">{siteConfig.phone}</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* The number under a call button, for screens that cannot place a
   * call — the home band's 2026-09-26 recipe, hand-copied (page-local
   * styles stay page-local). Sized at the operator's direction on the
   * preview — "hard to read" at 15px, "I need the phone number to be
   * larger" at 18px — so it is a line in its own right: 24px, semibold,
   * the same on the band. It inherits the surface's text color: ink-900
   * on the canvas, paper on noir. */
  .tox-phone {
    margin-top: 0.875rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  /* The requirement plates on noir: static boxes — the noir card is
   * transparent, the hairline is pink-500 at 55% (tokens.css), the 12px
   * radius is the arch family's foot corner — and no elevation
   * (tokens.css: never on a static box). The numeral is the treatment
   * card's index recipe at plate scale, in the display accent (pink-300
   * on noir): decorative, so no contrast pair is engaged, though 11.58:1
   * holds regardless. */
  .tox-plates {
    list-style: none;
    padding: 0;
  }
  .tox-plate {
    background: var(--ng-card);
    border: 1px solid var(--ng-hairline);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .tox-plate__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ng-display-accent);
  }
</style>
