---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAButton from '../components/CTAButton.astro';
import LocationCard from '../components/LocationCard.astro';

/**
 * /visit — location page (§6, Phase C1). NAP + directions live in
 * LocationCard (maps are link-outs, never embedded — §9/§10). Hours are
 * NOT listed anywhere on the site — Amy's decision (2026-08-04, closing
 * the {{HOURS}} token; DECISIONS same date) — so no copy here may
 * promise or imply hours. The parking note still waits on operator
 * wording (a new registry item, not yet in §17).
 *
 * The lead is the operator's sentence as typed (2026-09-30, from Amy;
 * DECISIONS same date), with a period and a comma before "but": the
 * Harrisburg medspa is her main one, and she also sees people in four
 * other places and at mobile parties in both Carolinas. "mobile
 * parties" links to /tox-together, the party page, in the house
 * inline-link idiom (PracticeLink's: underline + var(--ng-link)). The
 * card below still carries the one address; the other places have
 * none on the site.
 */
---

<BaseLayout
  title="Visit Amy | Needle Girlie"
  description="Needle Girlie — Amy Palacios, FNP, at 4350 Main Street, Suite 224, Harrisburg, NC 28075. Directions and contact."
>
  <Header slot="header" />

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <p class="eyebrow">The medspa</p>
    <hr class="rule-accent mt-4" aria-hidden="true" />
    <h1 class="display-2 mt-6">Visit Amy</h1>
    <p class="lead mt-6">
      Amy's main medspa is in Harrisburg, NC, but she also sees people in
      Waxhaw, Ballantyne, Concord, and Charlotte locations along with
      <a href="/tox-together" class="underline underline-offset-4" style="color: var(--ng-link)">mobile parties</a>
      in North and South Carolina.
    </p>
    <div class="mt-10">
      <LocationCard heading={'Location'} headingLevel="h2" />
    </div>
  </section>

  <section class="surface" data-surface="noir">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <div class="ng-rise">
        <p class="eyebrow">Appointments</p>
        <h2 class="display-2 mt-4">
          Ready <span class="display-accent ng-shimmer">when you are</span>.
        </h2>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <CTAButton variant="book" />
          <CTAButton variant="call" />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
